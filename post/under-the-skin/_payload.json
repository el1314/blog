[{"data":1,"prerenderedAt":146},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":19,"blog-post-slug-under-the-skin":36,"surround-under-the-skin":137},{"categories":4},[5,8,11,14,17],{"name":6,"len":7},"电影",5,{"name":9,"len":10},"电视剧",2,{"name":12,"len":13},"相册",1,{"name":15,"len":16},"动画",6,{"name":18,"len":13},"杂谈",{"latestBlog":20},[21,24,27,30,33],{"title":22,"slug":23},"三大队，“我执”是因为“我值”","endless-journey",{"title":25,"slug":26},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":28,"slug":29},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"title":31,"slug":32},"《云襄传》，反套路的武侠也挺好看","yun-xiang-zhuan",{"title":34,"slug":35},"《猎罪图鉴》，一个要素很多的大杂烩","under-the-skin",{"id":37,"title":34,"body":38,"categories":120,"description":121,"extension":122,"meta":123,"navigation":129,"path":130,"seo":131,"slug":35,"stem":132,"tags":133,"__hash__":136},"blog\u002Fblog\u002F2022-05-20-under-the-skin.md",{"type":39,"value":40,"toc":112},"minimark",[41,45,49,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106,109],[42,43,44],"h2",{"id":44},"画像师也来破案",[46,47,48],"p",{},"我也算看过很多推理作品了，但是以画像师为主角的还是第一次看到。",[46,50,51],{},"不过这剧算是双男主，画像师和警察，侦探和助手，常见的配对。檀健次演画像师，金世佳演警察。",[46,53,54],{},"画像师是个天才，7年前帮人按一张童年照片画出了成年后的像，于是害死了警察的师父。",[46,56,57],{},"自责的画像师从此封笔，考了编制，做了画像师。",[46,59,60],{},"警察一开始很排斥画像师，但画像师不光有高超的画技，更有温柔的内心，能够与所有人共情，看穿别人的脆弱、坚强与爱意。",[46,62,63],{},"画像师用自己的天才征服了警察，帮助破获了很多案子，也包括警察师父的那一宗。",[46,65,66],{},"但是结局不够吸引我，剩两集没看完就放下了。",[42,68,69],{"id":69},"耽美还是百合",[46,71,72],{},"有的人看到双男主就已经嗑起来了，但是我觉得他俩没什么火花。",[46,74,75],{},"从剧中的两人互动来看，编剧有意让他俩来点擦边的社会主义兄弟情，但是他俩演得真是纯兄弟，不带一点社会主义。",[46,77,78],{},"剧中有个案子，两个女学生谈恋爱没谈好，一个自杀了，另一个把她埋了，但是留下一个头骨放在身边。",[46,80,81],{},"这俩演得很有火花，大家看得很是入戏，纷纷为她们的爱情悲剧感到惋惜。",[46,83,84],{},"还好两位男主没有在戏外卖腐，不然我真的看不下去。",[42,86,87],{"id":87},"女性议题",[46,89,90],{},"《猎罪图鉴》是单元剧，每个单元的案子都是各自独立的，但是大家能从很多单元里看出一些主题。",[46,92,93],{},"整容医生性剥削病人，老师性骚扰学生，家暴，拐卖妇女，这些都是近年来公众非常重视的有女性受害的案件类型，剧里的案子破了，希望现实中的坏人也快点伏法吧。",[46,95,96],{},"剧中还借画像师之口给我们介绍了很多世界名画，比如《马拉之死》和《朱迪斯斩杀赫罗弗尼斯》，剧里把画和案件联系到一起，用画里的细节帮助破案，用案件的细节延伸解释名画，我真的非常喜欢。",[46,98,99],{},"虽然他的解读都是我之前在网上看到过的，不过不妨碍我喜欢这种安排。",[42,101,102],{"id":102},"结语",[46,104,105],{},"这部剧包含了很多我喜欢的要素，但是节奏和剧情确实有点松散，而且“状画像师之多智而近妖”，到最后我实在没有心力追下去了。",[46,107,108],{},"看了一下百科，发现编剧一栏竟然有6个人，那这没有散成流沙已经很不错了。",[46,110,111],{},"唉，又剧荒了。",{"title":113,"searchDepth":10,"depth":114,"links":115},"",3,[116,117,118,119],{"id":44,"depth":10,"text":44},{"id":69,"depth":10,"text":69},{"id":87,"depth":10,"text":87},{"id":102,"depth":10,"text":102},[9],"看口罩画脸，看头骨画脸，看童年画成年，看成年画童年，看AI合成脸还原人脸，他就是个神。","md",{"date":124,"language":125,"keywords":126,"comments":129},"2022-05-20","中文",[127,128],"耽美","影视评论",true,"\u002Fblog\u002F2022-05-20-under-the-skin",{"title":34,"description":121},"blog\u002F2022-05-20-under-the-skin",[134,135],"推理","女权","Z5EcEVO89DMV1KUaAD28aVC_IpuQdxaeYZSBmoRbQs8",[138,143],{"title":139,"path":140,"stem":141,"children":-1,"slug":142},"我画的银魂人物像","\u002Fblog\u002F2022-05-08-my-gintama-artwork","blog\u002F2022-05-08-my-gintama-artwork","my-gintama-artwork",{"title":31,"path":144,"stem":145,"children":-1,"slug":32},"\u002Fblog\u002F2023-05-27-yun-xiang-zhuan","blog\u002F2023-05-27-yun-xiang-zhuan",1788179689832]