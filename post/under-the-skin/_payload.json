[{"data":1,"prerenderedAt":151},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":20,"blog-post-slug-under-the-skin":37,"surround-under-the-skin":140},{"categories":4},[5,8,11,14,16,18],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",6,{"name":12,"len":13},"电视剧",3,{"name":15,"len":7},"相册",{"name":17,"len":10},"动画",{"name":19,"len":7},"杂谈",{"latestBlog":21},[22,25,28,31,34],{"title":23,"slug":24},"原创小说《醒来之后》","novel-woke-up",{"title":26,"slug":27},"《教场》，这次的侦探是警校教官","kyoujou",{"title":29,"slug":30},"三大队，“我执”是因为“我值”","endless-journey",{"title":32,"slug":33},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":35,"slug":36},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"id":38,"title":39,"body":40,"categories":122,"description":123,"extension":124,"meta":125,"navigation":131,"path":132,"seo":133,"slug":134,"stem":135,"tags":136,"__hash__":139},"blog\u002Fblog\u002F2022-05-20-under-the-skin.md","《猎罪图鉴》，一个要素很多的大杂烩",{"type":41,"value":42,"toc":114},"minimark",[43,47,51,54,57,60,63,66,69,72,75,78,81,84,87,90,93,96,99,102,105,108,111],[44,45,46],"h2",{"id":46},"画像师也来破案",[48,49,50],"p",{},"我也算看过很多推理作品了，但是以画像师为主角的还是第一次看到。",[48,52,53],{},"不过这剧算是双男主，画像师和警察，侦探和助手，常见的配对。檀健次演画像师，金世佳演警察。",[48,55,56],{},"画像师是个天才，7年前帮人按一张童年照片画出了成年后的像，于是害死了警察的师父。",[48,58,59],{},"自责的画像师从此封笔，考了编制，做了画像师。",[48,61,62],{},"警察一开始很排斥画像师，但画像师不光有高超的画技，更有温柔的内心，能够与所有人共情，看穿别人的脆弱、坚强与爱意。",[48,64,65],{},"画像师用自己的天才征服了警察，帮助破获了很多案子，也包括警察师父的那一宗。",[48,67,68],{},"但是结局不够吸引我，剩两集没看完就放下了。",[44,70,71],{"id":71},"耽美还是百合",[48,73,74],{},"有的人看到双男主就已经嗑起来了，但是我觉得他俩没什么火花。",[48,76,77],{},"从剧中的两人互动来看，编剧有意让他俩来点擦边的社会主义兄弟情，但是他俩演得真是纯兄弟，不带一点社会主义。",[48,79,80],{},"剧中有个案子，两个女学生谈恋爱没谈好，一个自杀了，另一个把她埋了，但是留下一个头骨放在身边。",[48,82,83],{},"这俩演得很有火花，大家看得很是入戏，纷纷为她们的爱情悲剧感到惋惜。",[48,85,86],{},"还好两位男主没有在戏外卖腐，不然我真的看不下去。",[44,88,89],{"id":89},"女性议题",[48,91,92],{},"《猎罪图鉴》是单元剧，每个单元的案子都是各自独立的，但是大家能从很多单元里看出一些主题。",[48,94,95],{},"整容医生性剥削病人，老师性骚扰学生，家暴，拐卖妇女，这些都是近年来公众非常重视的有女性受害的案件类型，剧里的案子破了，希望现实中的坏人也快点伏法吧。",[48,97,98],{},"剧中还借画像师之口给我们介绍了很多世界名画，比如《马拉之死》和《朱迪斯斩杀赫罗弗尼斯》，剧里把画和案件联系到一起，用画里的细节帮助破案，用案件的细节延伸解释名画，我真的非常喜欢。",[48,100,101],{},"虽然他的解读都是我之前在网上看到过的，不过不妨碍我喜欢这种安排。",[44,103,104],{"id":104},"结语",[48,106,107],{},"这部剧包含了很多我喜欢的要素，但是节奏和剧情确实有点松散，而且“状画像师之多智而近妖”，到最后我实在没有心力追下去了。",[48,109,110],{},"看了一下百科，发现编剧一栏竟然有6个人，那这没有散成流沙已经很不错了。",[48,112,113],{},"唉，又剧荒了。",{"title":115,"searchDepth":116,"depth":13,"links":117},"",2,[118,119,120,121],{"id":46,"depth":116,"text":46},{"id":71,"depth":116,"text":71},{"id":89,"depth":116,"text":89},{"id":104,"depth":116,"text":104},[12],"看口罩画脸，看头骨画脸，看童年画成年，看成年画童年，看AI合成脸还原人脸，他就是个神。","md",{"date":126,"language":127,"keywords":128,"comments":131},"2022-05-20","中文",[129,130],"耽美","影视评论",true,"\u002Fblog\u002F2022-05-20-under-the-skin",{"title":39,"description":123},"under-the-skin","blog\u002F2022-05-20-under-the-skin",[137,138],"推理","女权","Z5EcEVO89DMV1KUaAD28aVC_IpuQdxaeYZSBmoRbQs8",[141,146],{"title":142,"path":143,"stem":144,"children":-1,"slug":145},"我画的银魂人物像","\u002Fblog\u002F2022-05-08-my-gintama-artwork","blog\u002F2022-05-08-my-gintama-artwork","my-gintama-artwork",{"title":147,"path":148,"stem":149,"children":-1,"slug":150},"《云襄传》，反套路的武侠也挺好看","\u002Fblog\u002F2023-05-27-yun-xiang-zhuan","blog\u002F2023-05-27-yun-xiang-zhuan","yun-xiang-zhuan",1788428850078]