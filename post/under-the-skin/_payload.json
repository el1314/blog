[{"data":1,"prerenderedAt":150},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":21,"blog-post-slug-under-the-skin":38,"surround-under-the-skin":141},{"categories":4},[5,8,11,14,16,19],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",5,{"name":12,"len":13},"电视剧",2,{"name":15,"len":7},"相册",{"name":17,"len":18},"动画",6,{"name":20,"len":7},"杂谈",{"latestBlog":22},[23,26,29,32,35],{"title":24,"slug":25},"醒来之后","novel-woke-up",{"title":27,"slug":28},"三大队，“我执”是因为“我值”","endless-journey",{"title":30,"slug":31},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":33,"slug":34},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"title":36,"slug":37},"《云襄传》，反套路的武侠也挺好看","yun-xiang-zhuan",{"id":39,"title":40,"body":41,"categories":123,"description":124,"extension":125,"meta":126,"navigation":132,"path":133,"seo":134,"slug":135,"stem":136,"tags":137,"__hash__":140},"blog\u002Fblog\u002F2022-05-20-under-the-skin.md","《猎罪图鉴》，一个要素很多的大杂烩",{"type":42,"value":43,"toc":115},"minimark",[44,48,52,55,58,61,64,67,70,73,76,79,82,85,88,91,94,97,100,103,106,109,112],[45,46,47],"h2",{"id":47},"画像师也来破案",[49,50,51],"p",{},"我也算看过很多推理作品了，但是以画像师为主角的还是第一次看到。",[49,53,54],{},"不过这剧算是双男主，画像师和警察，侦探和助手，常见的配对。檀健次演画像师，金世佳演警察。",[49,56,57],{},"画像师是个天才，7年前帮人按一张童年照片画出了成年后的像，于是害死了警察的师父。",[49,59,60],{},"自责的画像师从此封笔，考了编制，做了画像师。",[49,62,63],{},"警察一开始很排斥画像师，但画像师不光有高超的画技，更有温柔的内心，能够与所有人共情，看穿别人的脆弱、坚强与爱意。",[49,65,66],{},"画像师用自己的天才征服了警察，帮助破获了很多案子，也包括警察师父的那一宗。",[49,68,69],{},"但是结局不够吸引我，剩两集没看完就放下了。",[45,71,72],{"id":72},"耽美还是百合",[49,74,75],{},"有的人看到双男主就已经嗑起来了，但是我觉得他俩没什么火花。",[49,77,78],{},"从剧中的两人互动来看，编剧有意让他俩来点擦边的社会主义兄弟情，但是他俩演得真是纯兄弟，不带一点社会主义。",[49,80,81],{},"剧中有个案子，两个女学生谈恋爱没谈好，一个自杀了，另一个把她埋了，但是留下一个头骨放在身边。",[49,83,84],{},"这俩演得很有火花，大家看得很是入戏，纷纷为她们的爱情悲剧感到惋惜。",[49,86,87],{},"还好两位男主没有在戏外卖腐，不然我真的看不下去。",[45,89,90],{"id":90},"女性议题",[49,92,93],{},"《猎罪图鉴》是单元剧，每个单元的案子都是各自独立的，但是大家能从很多单元里看出一些主题。",[49,95,96],{},"整容医生性剥削病人，老师性骚扰学生，家暴，拐卖妇女，这些都是近年来公众非常重视的有女性受害的案件类型，剧里的案子破了，希望现实中的坏人也快点伏法吧。",[49,98,99],{},"剧中还借画像师之口给我们介绍了很多世界名画，比如《马拉之死》和《朱迪斯斩杀赫罗弗尼斯》，剧里把画和案件联系到一起，用画里的细节帮助破案，用案件的细节延伸解释名画，我真的非常喜欢。",[49,101,102],{},"虽然他的解读都是我之前在网上看到过的，不过不妨碍我喜欢这种安排。",[45,104,105],{"id":105},"结语",[49,107,108],{},"这部剧包含了很多我喜欢的要素，但是节奏和剧情确实有点松散，而且“状画像师之多智而近妖”，到最后我实在没有心力追下去了。",[49,110,111],{},"看了一下百科，发现编剧一栏竟然有6个人，那这没有散成流沙已经很不错了。",[49,113,114],{},"唉，又剧荒了。",{"title":116,"searchDepth":13,"depth":117,"links":118},"",3,[119,120,121,122],{"id":47,"depth":13,"text":47},{"id":72,"depth":13,"text":72},{"id":90,"depth":13,"text":90},{"id":105,"depth":13,"text":105},[12],"看口罩画脸，看头骨画脸，看童年画成年，看成年画童年，看AI合成脸还原人脸，他就是个神。","md",{"date":127,"language":128,"keywords":129,"comments":132},"2022-05-20","中文",[130,131],"耽美","影视评论",true,"\u002Fblog\u002F2022-05-20-under-the-skin",{"title":40,"description":124},"under-the-skin","blog\u002F2022-05-20-under-the-skin",[138,139],"推理","女权","Z5EcEVO89DMV1KUaAD28aVC_IpuQdxaeYZSBmoRbQs8",[142,147],{"title":143,"path":144,"stem":145,"children":-1,"slug":146},"我画的银魂人物像","\u002Fblog\u002F2022-05-08-my-gintama-artwork","blog\u002F2022-05-08-my-gintama-artwork","my-gintama-artwork",{"title":36,"path":148,"stem":149,"children":-1,"slug":37},"\u002Fblog\u002F2023-05-27-yun-xiang-zhuan","blog\u002F2023-05-27-yun-xiang-zhuan",1788189923541]