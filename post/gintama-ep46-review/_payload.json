[{"data":1,"prerenderedAt":109},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":20,"blog-post-slug-gintama-ep46-review":37,"surround-gintama-ep46-review":98},{"categories":4},[5,8,11,14,16,18],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",6,{"name":12,"len":13},"电视剧",3,{"name":15,"len":7},"相册",{"name":17,"len":10},"动画",{"name":19,"len":7},"杂谈",{"latestBlog":21},[22,25,28,31,34],{"title":23,"slug":24},"原创小说《醒来之后》","novel-woke-up",{"title":26,"slug":27},"《教场》，这次的侦探是警校教官","kyoujou",{"title":29,"slug":30},"三大队，“我执”是因为“我值”","endless-journey",{"title":32,"slug":33},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":35,"slug":36},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"id":38,"title":39,"body":40,"categories":81,"description":82,"extension":83,"meta":84,"navigation":90,"path":91,"seo":92,"slug":93,"stem":94,"tags":95,"__hash__":97},"blog\u002Fblog\u002F2022-02-01-gintama-ep46-review.md","《银魂》第46集，被胜负蒙蔽了双眼的女人很可怕吗？",{"type":41,"value":42,"toc":77},"minimark",[43,47,50,53,56,59,62,65,68,71,74],[44,45,46],"p",{},"《银魂》和传统的Jump热血少年漫画不一样，它在友情、亲情、战斗之外，还有无厘头搞笑，以及擦边擦到极限马上就要不过审的低俗。",[44,48,49],{},"这部作品里出现的每一个人都有可爱、可乐、可笑、可气、可鄙以及各种其他作品里没有的特质，每个人都不是完人，但都是有意思的人。",[44,51,52],{},"当男性角色以不那么正面的形象出现的时候，弹幕里多是一片哈哈哈，有的人甚至会说一些略显猥琐的梗，但是没有一个人说讨厌。",[44,54,55],{},"当女性角色以不温柔不体贴的形象出现的时候，弹幕里便开始心疼没有被温柔对待的男性。",[44,57,58],{},"到第46集，阿妙和阿音为了比拼业绩而使出浑身解数，让松平、近藤、阿银、Madao掏空了钱包，走时只能穿着裤衩面对萧瑟寒风。",[44,60,61],{},"此时我第一次在弹幕里见到“讨厌”这个词。",[44,63,64],{},"弹幕不只是“讨厌”阿妙，还开始说什么“陪酒女没有心”之类的话，从表达个人好恶上升到了对阿妙的人身攻击。",[44,66,67],{},"之前笨蛋王子那么多次把江户搞得一团糟，也没见弹幕说过一句讨厌，现在他们见到女人毫不为男人考虑，只想让男人花钱，就这样破防了。",[44,69,70],{},"多有意思啊。",[44,72,73],{},"你有心，你到夜总会来寻欢作乐？你比空知英秋还会搞笑，哈哈哈！",[44,75,76],{},"全文完。",{"title":78,"searchDepth":79,"depth":13,"links":80},"",2,[],[17],"同在夜总会工作的阿妙和阿音，为了争得业绩第一而不断掏空男人们的钱包，长久以来只会哈哈哈的观众终于破防了。","md",{"date":85,"language":86,"keywords":87,"comments":90},"2022-02-01","中文",[88,89],"厌女","影视评论",true,"\u002Fblog\u002F2022-02-01-gintama-ep46-review",{"title":39,"description":82},"gintama-ep46-review","blog\u002F2022-02-01-gintama-ep46-review",[96],"银魂","f47DbNALTHbV_7pnZiCVi5zB18-w0w-u6AIV0t1MmuI",[99,104],{"title":100,"path":101,"stem":102,"children":-1,"slug":103},"《三角窗外是黑夜》——批皮耽美是诈骗","\u002Fblog\u002F2022-01-31-sankaku-mado-no-sotogawa-wa-yoru","blog\u002F2022-01-31-sankaku-mado-no-sotogawa-wa-yoru","sankaku-mado-no-sotogawa-wa-yoru",{"title":105,"path":106,"stem":107,"children":-1,"slug":108},"《银魂》第49集，终于集齐了黄赌毒","\u002Fblog\u002F2022-02-02-gintama-ep49-review","blog\u002F2022-02-02-gintama-ep49-review","gintama-ep49-review",1788370014994]