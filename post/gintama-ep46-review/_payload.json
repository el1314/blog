[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":21,"blog-post-slug-gintama-ep46-review":38,"surround-gintama-ep46-review":99},{"categories":4},[5,8,11,14,16,19],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",5,{"name":12,"len":13},"电视剧",2,{"name":15,"len":7},"相册",{"name":17,"len":18},"动画",6,{"name":20,"len":7},"杂谈",{"latestBlog":22},[23,26,29,32,35],{"title":24,"slug":25},"醒来之后","novel-woke-up",{"title":27,"slug":28},"三大队，“我执”是因为“我值”","endless-journey",{"title":30,"slug":31},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":33,"slug":34},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"title":36,"slug":37},"《云襄传》，反套路的武侠也挺好看","yun-xiang-zhuan",{"id":39,"title":40,"body":41,"categories":82,"description":83,"extension":84,"meta":85,"navigation":91,"path":92,"seo":93,"slug":94,"stem":95,"tags":96,"__hash__":98},"blog\u002Fblog\u002F2022-02-01-gintama-ep46-review.md","《银魂》第46集，被胜负蒙蔽了双眼的女人很可怕吗？",{"type":42,"value":43,"toc":78},"minimark",[44,48,51,54,57,60,63,66,69,72,75],[45,46,47],"p",{},"《银魂》和传统的Jump热血少年漫画不一样，它在友情、亲情、战斗之外，还有无厘头搞笑，以及擦边擦到极限马上就要不过审的低俗。",[45,49,50],{},"这部作品里出现的每一个人都有可爱、可乐、可笑、可气、可鄙以及各种其他作品里没有的特质，每个人都不是完人，但都是有意思的人。",[45,52,53],{},"当男性角色以不那么正面的形象出现的时候，弹幕里多是一片哈哈哈，有的人甚至会说一些略显猥琐的梗，但是没有一个人说讨厌。",[45,55,56],{},"当女性角色以不温柔不体贴的形象出现的时候，弹幕里便开始心疼没有被温柔对待的男性。",[45,58,59],{},"到第46集，阿妙和阿音为了比拼业绩而使出浑身解数，让松平、近藤、阿银、Madao掏空了钱包，走时只能穿着裤衩面对萧瑟寒风。",[45,61,62],{},"此时我第一次在弹幕里见到“讨厌”这个词。",[45,64,65],{},"弹幕不只是“讨厌”阿妙，还开始说什么“陪酒女没有心”之类的话，从表达个人好恶上升到了对阿妙的人身攻击。",[45,67,68],{},"之前笨蛋王子那么多次把江户搞得一团糟，也没见弹幕说过一句讨厌，现在他们见到女人毫不为男人考虑，只想让男人花钱，就这样破防了。",[45,70,71],{},"多有意思啊。",[45,73,74],{},"你有心，你到夜总会来寻欢作乐？你比空知英秋还会搞笑，哈哈哈！",[45,76,77],{},"全文完。",{"title":79,"searchDepth":13,"depth":80,"links":81},"",3,[],[17],"同在夜总会工作的阿妙和阿音，为了争得业绩第一而不断掏空男人们的钱包，长久以来只会哈哈哈的观众终于破防了。","md",{"date":86,"language":87,"keywords":88,"comments":91},"2022-02-01","中文",[89,90],"厌女","影视评论",true,"\u002Fblog\u002F2022-02-01-gintama-ep46-review",{"title":40,"description":83},"gintama-ep46-review","blog\u002F2022-02-01-gintama-ep46-review",[97],"银魂","f47DbNALTHbV_7pnZiCVi5zB18-w0w-u6AIV0t1MmuI",[100,105],{"title":101,"path":102,"stem":103,"children":-1,"slug":104},"《三角窗外是黑夜》——批皮耽美是诈骗","\u002Fblog\u002F2022-01-31-sankaku-mado-no-sotogawa-wa-yoru","blog\u002F2022-01-31-sankaku-mado-no-sotogawa-wa-yoru","sankaku-mado-no-sotogawa-wa-yoru",{"title":106,"path":107,"stem":108,"children":-1,"slug":109},"《银魂》第49集，终于集齐了黄赌毒","\u002Fblog\u002F2022-02-02-gintama-ep49-review","blog\u002F2022-02-02-gintama-ep49-review","gintama-ep49-review",1788189925431]