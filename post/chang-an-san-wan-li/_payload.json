[{"data":1,"prerenderedAt":131},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":21,"blog-post-slug-chang-an-san-wan-li":38,"surround-chang-an-san-wan-li":124},{"categories":4},[5,8,11,14,16,19],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",5,{"name":12,"len":13},"电视剧",2,{"name":15,"len":7},"相册",{"name":17,"len":18},"动画",6,{"name":20,"len":7},"杂谈",{"latestBlog":22},[23,26,29,32,35],{"title":24,"slug":25},"醒来之后","novel-woke-up",{"title":27,"slug":28},"三大队，“我执”是因为“我值”","endless-journey",{"title":30,"slug":31},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":33,"slug":34},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"title":36,"slug":37},"《云襄传》，反套路的武侠也挺好看","yun-xiang-zhuan",{"id":39,"title":30,"body":40,"categories":109,"description":110,"extension":111,"meta":112,"navigation":117,"path":118,"seo":119,"slug":31,"stem":120,"tags":121,"__hash__":123},"blog\u002Fblog\u002F2023-08-01-chang-an-san-wan-li.md",{"type":41,"value":42,"toc":103},"minimark",[43,47,51,54,57,60,64,67,70,73,76,79,82,85,88,91,94,97,100],[44,45,46],"h2",{"id":46},"李白和高适",[48,49,50],"p",{},"《长安三万里》用高适的视角带我们认识了李白，结交了杜甫、王维、李龟年等人，窥探到了大唐最盛大也是最后的那一点繁华。",[48,52,53],{},"电影里的李白大概是这样的：",[48,55,56],{},"生来潇洒，却望高处。广交豪杰，饮酒赋诗。浪荡半生，仕途坎坷。谪仙下凡，历劫而归。",[48,58,59],{},"高适和李白惺惺相惜，在分分合合中虚度半生，高适晚年得志，李白却晚节不保，卷入谋反事件，后又被赦免，不过没过多久两人就相会于丰都了。",[44,61,63],{"id":62},"入赘怎么了","入赘怎么了？",[48,65,66],{},"李白家里经商，在士农工商四个阶层的最底层，考科举过不了政审，只能结识权贵以求举荐，是为“行卷”。",[48,68,69],{},"虽然在民间声名远播，但是总没有贵人看中他，于是出仕无门。",[48,71,72],{},"家变之后身无长物，李白犹豫要不要入赘讨生活，高适反对，孟浩然支持。",[48,74,75],{},"入赘这个事之所以会成为值得讨论的问题，是因为社会上对舍弃自家姓氏，成为别家赘婿的人多有贬低。",[48,77,78],{},"一旦入赘，自己的才能是女家的，自己的孩子是女家的，连自己都是女家的。",[48,80,81],{},"但这不就是一个普通的出嫁女会遇到的事吗？",[48,83,84],{},"一个普通女人，无权也无势，空有持家经营之能，生儿育女之力，必须抛父弃母，尊非亲为亲，认非故为故，付出双手和血肉，如此才有立锥之地。",[48,86,87],{},"我又想起了《长月烬明》的那句名台词“求生之举，难道还分高贵和下贱吗？”",[48,89,90],{},"为什么普通女人天天都在求生，大家习以为常，而少数男人遇到这个情况，却会被人同情？",[48,92,93],{},"现代网文里，“赘婿”可是一个大类，多少男作家和男读者用男主的身份在虚构的老丈人面前扬眉吐气。如果李白活跃在现代，少不得也要写两篇吧。",[48,95,96],{},"况且根据历史爱好者的说法，李白的后代还是跟他姓李，所以应该算是他白得了人家的好处，却什么也没付出吧？",[48,98,99],{},"男的可以考功名，可以求举荐，可以放浪形骸，可以厚积薄发，但是到女人这里就没什么能选的了。",[48,101,102],{},"这种就叫做双标哈。",{"title":104,"searchDepth":13,"depth":105,"links":106},"",3,[107,108],{"id":46,"depth":13,"text":46},{"id":62,"depth":13,"text":63},[9],"长安三万里，只有男诗人。","md",{"date":113,"language":114,"keywords":115,"comments":117},"2023-08-01","中文",[116],"李白",true,"\u002Fblog\u002F2023-08-01-chang-an-san-wan-li",{"title":30,"description":110},"blog\u002F2023-08-01-chang-an-san-wan-li",[122],"唐朝","9dyFsgl_HgHZsunOa7XQrpgP_Zau6csBuVPS7ClvfEw",[125,128],{"title":33,"path":126,"stem":127,"children":-1,"slug":34},"\u002Fblog\u002F2023-07-31-no-longer-a-barbie","blog\u002F2023-07-31-no-longer-a-barbie",{"title":27,"path":129,"stem":130,"children":-1,"slug":28},"\u002Fblog\u002F2023-12-19-endless-journey","blog\u002F2023-12-19-endless-journey",1788189923448]