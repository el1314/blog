[{"data":1,"prerenderedAt":130},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":20,"blog-post-slug-chang-an-san-wan-li":37,"surround-chang-an-san-wan-li":123},{"categories":4},[5,8,11,14,16,18],{"name":6,"len":7},"原创小说",1,{"name":9,"len":10},"电影",6,{"name":12,"len":13},"电视剧",3,{"name":15,"len":7},"相册",{"name":17,"len":10},"动画",{"name":19,"len":7},"杂谈",{"latestBlog":21},[22,25,28,31,34],{"title":23,"slug":24},"原创小说《醒来之后》","novel-woke-up",{"title":26,"slug":27},"《教场》，这次的侦探是警校教官","kyoujou",{"title":29,"slug":30},"三大队，“我执”是因为“我值”","endless-journey",{"title":32,"slug":33},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":35,"slug":36},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"id":38,"title":32,"body":39,"categories":108,"description":109,"extension":110,"meta":111,"navigation":116,"path":117,"seo":118,"slug":33,"stem":119,"tags":120,"__hash__":122},"blog\u002Fblog\u002F2023-08-01-chang-an-san-wan-li.md",{"type":40,"value":41,"toc":102},"minimark",[42,46,50,53,56,59,63,66,69,72,75,78,81,84,87,90,93,96,99],[43,44,45],"h2",{"id":45},"李白和高适",[47,48,49],"p",{},"《长安三万里》用高适的视角带我们认识了李白，结交了杜甫、王维、李龟年等人，窥探到了大唐最盛大也是最后的那一点繁华。",[47,51,52],{},"电影里的李白大概是这样的：",[47,54,55],{},"生来潇洒，却望高处。广交豪杰，饮酒赋诗。浪荡半生，仕途坎坷。谪仙下凡，历劫而归。",[47,57,58],{},"高适和李白惺惺相惜，在分分合合中虚度半生，高适晚年得志，李白却晚节不保，卷入谋反事件，后又被赦免，不过没过多久两人就相会于丰都了。",[43,60,62],{"id":61},"入赘怎么了","入赘怎么了？",[47,64,65],{},"李白家里经商，在士农工商四个阶层的最底层，考科举过不了政审，只能结识权贵以求举荐，是为“行卷”。",[47,67,68],{},"虽然在民间声名远播，但是总没有贵人看中他，于是出仕无门。",[47,70,71],{},"家变之后身无长物，李白犹豫要不要入赘讨生活，高适反对，孟浩然支持。",[47,73,74],{},"入赘这个事之所以会成为值得讨论的问题，是因为社会上对舍弃自家姓氏，成为别家赘婿的人多有贬低。",[47,76,77],{},"一旦入赘，自己的才能是女家的，自己的孩子是女家的，连自己都是女家的。",[47,79,80],{},"但这不就是一个普通的出嫁女会遇到的事吗？",[47,82,83],{},"一个普通女人，无权也无势，空有持家经营之能，生儿育女之力，必须抛父弃母，尊非亲为亲，认非故为故，付出双手和血肉，如此才有立锥之地。",[47,85,86],{},"我又想起了《长月烬明》的那句名台词“求生之举，难道还分高贵和下贱吗？”",[47,88,89],{},"为什么普通女人天天都在求生，大家习以为常，而少数男人遇到这个情况，却会被人同情？",[47,91,92],{},"现代网文里，“赘婿”可是一个大类，多少男作家和男读者用男主的身份在虚构的老丈人面前扬眉吐气。如果李白活跃在现代，少不得也要写两篇吧。",[47,94,95],{},"况且根据历史爱好者的说法，李白的后代还是跟他姓李，所以应该算是他白得了人家的好处，却什么也没付出吧？",[47,97,98],{},"男的可以考功名，可以求举荐，可以放浪形骸，可以厚积薄发，但是到女人这里就没什么能选的了。",[47,100,101],{},"这种就叫做双标哈。",{"title":103,"searchDepth":104,"depth":13,"links":105},"",2,[106,107],{"id":45,"depth":104,"text":45},{"id":61,"depth":104,"text":62},[9],"长安三万里，只有男诗人。","md",{"date":112,"language":113,"keywords":114,"comments":116},"2023-08-01","中文",[115],"李白",true,"\u002Fblog\u002F2023-08-01-chang-an-san-wan-li",{"title":32,"description":109},"blog\u002F2023-08-01-chang-an-san-wan-li",[121],"唐朝","9dyFsgl_HgHZsunOa7XQrpgP_Zau6csBuVPS7ClvfEw",[124,127],{"title":35,"path":125,"stem":126,"children":-1,"slug":36},"\u002Fblog\u002F2023-07-31-no-longer-a-barbie","blog\u002F2023-07-31-no-longer-a-barbie",{"title":29,"path":128,"stem":129,"children":-1,"slug":30},"\u002Fblog\u002F2023-12-19-endless-journey","blog\u002F2023-12-19-endless-journey",1788370012927]