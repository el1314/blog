[{"data":1,"prerenderedAt":129},["ShallowReactive",2],{"aside-categories":3,"aside-latestBlog":19,"blog-post-slug-chang-an-san-wan-li":36,"surround-chang-an-san-wan-li":122},{"categories":4},[5,8,11,14,17],{"name":6,"len":7},"电影",5,{"name":9,"len":10},"电视剧",2,{"name":12,"len":13},"相册",1,{"name":15,"len":16},"动画",6,{"name":18,"len":13},"杂谈",{"latestBlog":20},[21,24,27,30,33],{"title":22,"slug":23},"三大队，“我执”是因为“我值”","endless-journey",{"title":25,"slug":26},"长安三万里--李白不能入赘吗？","chang-an-san-wan-li",{"title":28,"slug":29},"《芭比》，是女儿，也是母亲","no-longer-a-barbie",{"title":31,"slug":32},"《云襄传》，反套路的武侠也挺好看","yun-xiang-zhuan",{"title":34,"slug":35},"《猎罪图鉴》，一个要素很多的大杂烩","under-the-skin",{"id":37,"title":25,"body":38,"categories":107,"description":108,"extension":109,"meta":110,"navigation":115,"path":116,"seo":117,"slug":26,"stem":118,"tags":119,"__hash__":121},"blog\u002Fblog\u002F2023-08-01-chang-an-san-wan-li.md",{"type":39,"value":40,"toc":101},"minimark",[41,45,49,52,55,58,62,65,68,71,74,77,80,83,86,89,92,95,98],[42,43,44],"h2",{"id":44},"李白和高适",[46,47,48],"p",{},"《长安三万里》用高适的视角带我们认识了李白，结交了杜甫、王维、李龟年等人，窥探到了大唐最盛大也是最后的那一点繁华。",[46,50,51],{},"电影里的李白大概是这样的：",[46,53,54],{},"生来潇洒，却望高处。广交豪杰，饮酒赋诗。浪荡半生，仕途坎坷。谪仙下凡，历劫而归。",[46,56,57],{},"高适和李白惺惺相惜，在分分合合中虚度半生，高适晚年得志，李白却晚节不保，卷入谋反事件，后又被赦免，不过没过多久两人就相会于丰都了。",[42,59,61],{"id":60},"入赘怎么了","入赘怎么了？",[46,63,64],{},"李白家里经商，在士农工商四个阶层的最底层，考科举过不了政审，只能结识权贵以求举荐，是为“行卷”。",[46,66,67],{},"虽然在民间声名远播，但是总没有贵人看中他，于是出仕无门。",[46,69,70],{},"家变之后身无长物，李白犹豫要不要入赘讨生活，高适反对，孟浩然支持。",[46,72,73],{},"入赘这个事之所以会成为值得讨论的问题，是因为社会上对舍弃自家姓氏，成为别家赘婿的人多有贬低。",[46,75,76],{},"一旦入赘，自己的才能是女家的，自己的孩子是女家的，连自己都是女家的。",[46,78,79],{},"但这不就是一个普通的出嫁女会遇到的事吗？",[46,81,82],{},"一个普通女人，无权也无势，空有持家经营之能，生儿育女之力，必须抛父弃母，尊非亲为亲，认非故为故，付出双手和血肉，如此才有立锥之地。",[46,84,85],{},"我又想起了《长月烬明》的那句名台词“求生之举，难道还分高贵和下贱吗？”",[46,87,88],{},"为什么普通女人天天都在求生，大家习以为常，而少数男人遇到这个情况，却会被人同情？",[46,90,91],{},"现代网文里，“赘婿”可是一个大类，多少男作家和男读者用男主的身份在虚构的老丈人面前扬眉吐气。如果李白活跃在现代，少不得也要写两篇吧。",[46,93,94],{},"况且根据历史爱好者的说法，李白的后代还是跟他姓李，所以应该算是他白得了人家的好处，却什么也没付出吧？",[46,96,97],{},"男的可以考功名，可以求举荐，可以放浪形骸，可以厚积薄发，但是到女人这里就没什么能选的了。",[46,99,100],{},"这种就叫做双标哈。",{"title":102,"searchDepth":10,"depth":103,"links":104},"",3,[105,106],{"id":44,"depth":10,"text":44},{"id":60,"depth":10,"text":61},[6],"长安三万里，只有男诗人。","md",{"date":111,"language":112,"keywords":113,"comments":115},"2023-08-01","中文",[114],"李白",true,"\u002Fblog\u002F2023-08-01-chang-an-san-wan-li",{"title":25,"description":108},"blog\u002F2023-08-01-chang-an-san-wan-li",[120],"唐朝","9dyFsgl_HgHZsunOa7XQrpgP_Zau6csBuVPS7ClvfEw",[123,126],{"title":28,"path":124,"stem":125,"children":-1,"slug":29},"\u002Fblog\u002F2023-07-31-no-longer-a-barbie","blog\u002F2023-07-31-no-longer-a-barbie",{"title":22,"path":127,"stem":128,"children":-1,"slug":23},"\u002Fblog\u002F2023-12-19-endless-journey","blog\u002F2023-12-19-endless-journey",1788179689831]